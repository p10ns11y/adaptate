# === Adaptate monorepo ===
#
# Primary intent: protect contributors from supply-chain harm (malicious lifecycle
# scripts, worms like Shai-Hulud, dependency confusion, tampered tarballs) when they
# install and build using the intended toolchain. Settings below lock down installs
# (e.g. no arbitrary postinstall execution, exact versions, strict isolation).
#
# Those protections are designed for pnpm plus root `pnpm-workspace.yaml` policies.
# Running `npm install` here is unsupported: npm ignores several pnpm-only keys,
# applies others differently, and can pull a different graph than CI — undermining the
# defenses we rely on. Use `pnpm install` only (see root `package.json` `packageManager`).

# === Strong Protection Against Shai-Hulud & npm Worms ===

# Block all lifecycle scripts (preinstall, postinstall, etc.)
ignore-scripts=true

# Force exact versions (prevents floating ranges)
save-exact=true

# Keep hoisting disabled for better isolation
shamefully-hoist=false

# Prevent hoisting of public packages (prefer explicit workspace: references)
public-hoist-pattern=[]