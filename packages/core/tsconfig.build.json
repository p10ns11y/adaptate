{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "rootDir": "./src",
    "outDir": "./build",
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/index.ts", "src/stream.ts", "src/stream-incremental.ts", "src/standard.ts", "src/effect.ts", "src/result.ts", "src/verify.ts"]
}