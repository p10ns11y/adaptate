{
  "name": "adaptate-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build && pnpm --filter adaptate-live-load build && node scripts/build-load.mjs && node scripts/build-docs.mjs && node scripts/build-seo.mjs",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware -c ../../.oxlintrc.json ./src ./scripts",
    "test": "pnpm --dir ../.. exec vitest run --config apps/site/vitest.config.mjs",
    "snippets": "node scripts/snippets.mjs",
    "snippets:check": "node scripts/snippets.mjs --check",
    "budget": "node scripts/budget.mjs",
    "seo-check": "node scripts/seo-check.mjs",
    "link-check": "node scripts/link-check.mjs",
    "preview": "vite preview",
    "a11y": "node scripts/a11y-check.mjs",
    "words": "node scripts/landing-words.mjs"
  },
  "dependencies": {
    "@adaptate/core": "workspace:*",
    "@adaptate/utils": "workspace:*",
    "@adaptate/wasm": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "effect": "4.1.4",
    "js-yaml": "5.5.0",
    "marked": "18.2.1",
    "mermaid": "12.3.0",
    "playwright": "1.65.1",
    "shiki": "4.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
