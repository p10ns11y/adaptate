{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^check-types", "^test"],
      "outputs": ["build/**", "ssr-build/**"]
    },
    "adaptate-live-load#build": {
      "dependsOn": ["@adaptate/core#build", "@adaptate/utils#build"],
      "outputs": ["dist/**"]
    },
    "adaptate-site#build": {
      "dependsOn": ["@adaptate/core#build", "@adaptate/utils#build", "@adaptate/wasm#build"],
      "env": ["SITE_URL"],
      "outputs": ["dist/**", ".site-meta/**"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
