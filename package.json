{
  "name": "adaptate",
  "version": "2.2.3-beta.0",
  "author": {
    "name": "Peramanathan Sathyamoorthy",
    "url": "https://github.com/p10ns11y/adaptate.git"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p10ns11y/adaptate.git"
  },
  "bugs": {
    "url": "https://github.com/p10ns11y/adaptate/issues"
  },
  "homepage": "https://github.com/p10ns11y/adaptate#readme",
  "license": "MIT",
  "type": "module",
  "source": "./packages/core/src/index.ts",
  "main": "./packages/core/build/index.es.js",
  "types": "./packages/core/build/index.d.ts",
  "files": [
    "./packages/core/build",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "test": "turbo run check-types --filter=@adaptate/core --filter=@adaptate/utils && vitest run --coverage",
    "test:watch": "vitest --coverage",
    "typecheck": "turbo run check-types --filter=@adaptate/core --filter=@adaptate/utils",
    "build": "turbo run build",
    "coveragebadge": "pnpm run test && npx make-coverage-badge --output-path ./coverage-badge.svg",
    "lint": "turbo run lint",
    "lint:fix": "pnpm exec oxlint --fix -c .oxlintrc.json ./packages/core/src ./packages/utils/src && pnpm run lint:deprecation",
    "lint:ox": "oxlint -c .oxlintrc.json ./packages/core/src ./packages/utils/src",
    "lint:deprecation": "eslint \"packages/core/src/**/*.ts\" \"packages/utils/src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "oxlint": "^1.63.0",
    "turbo": "^2.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  },
  "description": "Dynamic and Adaptable Model Validator Using Zod, Interoperable with OpenAPI",
  "keywords": [
    "Zod",
    "OpenAPI",
    "Schema Validation",
    "JSON Schema",
    "TypeScript",
    "Dynamic Validation",
    "Conditional Requirements",
    "React Hooks",
    "Data Validation",
    "API Integration",
    "Model Validator",
    "Schema Transformation",
    "Runtime Validation",
    "Component Props Validation",
    "Business Data Abstraction"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.1.1"
}