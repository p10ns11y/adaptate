# Snyk (https://snyk.io) policy file

# Exclude root-level files that Snyk has trouble processing in monorepos
exclude:
  code:
    - 'package.json'
    - 'pnpm-lock.yaml'

ignore:
  # Temporary ignore for initial release
  '*':
    - reason: 'Initial release - vulnerabilities will be addressed later'
      expires: 2026-07-01T00:00:00.000Z
