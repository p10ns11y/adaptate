# Snyk (https://snyk.io) policy file

# Workaround for Snyk failing to process pnpm lockfileVersion 9.0 + monorepo
exclude:
  code:
    - 'package.json'
    - 'pnpm-lock.yaml'
    - '**/package.json'
    - '**/pnpm-lock.yaml'

# Also ignore all issues temporarily
ignore:
  '*':
    - reason: 'pnpm lockfile v9 + Snyk compatibility issue - will be fixed after initial release'
      expires: 2026-07-01T00:00:00.000Z
